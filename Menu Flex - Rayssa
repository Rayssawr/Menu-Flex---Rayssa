<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Atividade</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: system-ui, -apple-system, sans-serif;
            background: #ffffff;
            background-color: rgb(255, 255, 255);
        }

        header {
            background: #43c069;
            height: 80px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
        }

        .icon-btn {
            background: none;
            border: none;
            color: #ffffff;
            display: flex;
            cursor: pointer;
        }

        .icon-btn svg {
            width: 24px;
            height: 24px;
        }

        .logo {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-decoration: none;
            color: #ffffff;
            font-weight: 800;
            font-size: 24px;
            line-height: 1;
        }
    </style>
</head>
<body>

    <header>
    
        <button type="button" class="icon-btn" aria-label="Menu">
            <img src="menu-aberto.png" alt="" class="btn-icon" height="25">
        </button>

     
        <a href="#" class="logo">
            <div class="logo-text"><span></span>Blog NX Cursos</div>
        </a>

     
        <button type="button" class="icon-btn" aria-label="Buscar">
            <img src="lupa.png" alt="" class="btn-icon" height="25">
        </button>
    </header>

</body>
</html>
